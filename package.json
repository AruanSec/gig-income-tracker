{
  "name": "gig-income-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts scripts/create-admin.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outdir=dist --entry-names=[name] --out-extension:.js=.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx test_runner.ts && tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:api": "tsx --test tests/api.integration.ts",
    "test:deployment": "node tests/deployment.integration.mjs",
    "test:security": "node tests/security.audit.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:release": "npm run verify && npm run test:api && npm run test:e2e && npm run test:security && npm run test:deployment"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.11.1",
    "body-parser": "^1.20.9",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7"
  }
}
